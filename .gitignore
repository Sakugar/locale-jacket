# Dependencies
node_modules/

# Build output (regenerated by `npm run build` / `npm test`)
dist/
build/
*.tsbuildinfo

# Packaged extensions and signing keys (never commit a .pem: it is the extension's private key)
*.zip
*.crx
*.pem

# Logs
*.log
npm-debug.log*

# Local scratch and test artifacts
.tmp/
coverage/
e2e/artifacts/

# Environment files
.env
.env.*

# Claude Code project instructions and per-user settings
/claude.md
/CLAUDE.md
.claude/settings.local.json

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
release/

# Extension signing keys (CRX). Never commit.
keys/
