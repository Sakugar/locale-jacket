{
  "name": "locale-jacket",
  "version": "1.2.2",
  "private": true,
  "description": "Chrome/Edge MV3 extension: per-domain browser locale spoofing via the Chrome DevTools Protocol.",
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/build.mjs --tests && node --test --test-reporter=spec \"build/test/**/*.test.js\"",
    "e2e": "node scripts/build.mjs && node e2e/run.mjs",
    "serve:verify": "node verify/server.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "e2e:edge": "node scripts/build.mjs && node e2e/run.mjs --edge",
    "e2e:launch": "node scripts/build.mjs && node e2e/launch-perf.mjs",
    "screenshots": "node scripts/build.mjs && node e2e/screenshots.mjs",
    "crx": "node scripts/build.mjs && node scripts/pack-crx.mjs",
    "diff-pack": "node scripts/build.mjs && node scripts/diff-pack.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
